{
  "name": "fde-ai-knowledge-base",
  "version": "0.1.0",
  "private": true,
  "description": "Forward Deployed Engineer — 現場に AI を組み込むための実践ナレッジベース",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @fde/web dev",
    "shot": "node scripts/screenshot.mjs",
    "build:web": "pnpm --filter @fde/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm build:mobile-content && pnpm build:web && playwright test",
    "validate:content": "tsx scripts/validate-content.ts",
    "build:mobile-content": "tsx scripts/build-content.ts",
    "predev": "pnpm build:mobile-content",
    "prebuild:web": "pnpm build:mobile-content",
    "pretypecheck": "pnpm build:mobile-content"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
